{
  "name": "ogl",
  "version": "1.0.0",
  "description": "OGL Vanilla TypeScript Template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"ROLLUP,HTTP\" -c \"bgBlue.bold,bgGreen.bold\" \"rollup -c -w -m inline\" \"servez public\"",
    "start": "servez public",
    "build": "rollup -c"
  },
  "dependencies": {
    "ogl": "pschroen/ogl#feat/sampler-3d"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "servez": "^2.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css",
    "printWidth": 200,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "useTabs": false
  }
}
